# ==========================================
# HostelShare Backend Configuration (.env)
# ==========================================

# 1. Database Configuration
# Supabase PostgreSQL connection string format:
# postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# (If left blank, automatically defaults to sqlite:///./hostelshare.db for local offline testing)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# 2. JWT Authentication Secret
JWT_SECRET=supersecretjwtkey_change_me_in_production_hostelshare_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Development / Mock OTP
DEV_MOCK_OTP=123456

# 4. CORS Origins (comma-separated, or * to allow all for local multi-phone testing)
ALLOWED_ORIGINS=*

# 5. Supabase Storage Configuration (for EXIF-stripped media upload)
# Public Bucket name: hostelshare-media (with subfolders /avatars and /items)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY
SUPABASE_BUCKET=hostelshare-media

# 6. Network Host and Port
HOST=0.0.0.0
PORT=8000
